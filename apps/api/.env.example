# Copier en `.env` (déjà présent en dev). Doit correspondre au docker-compose.yml à la racine.
DATABASE_URL="postgresql://syndic:syndic_dev_pwd@localhost:5435/syndic_alpha?schema=public"
PORT=3013

# Secret de signature des JWT (HS256) — OBLIGATOIRE, au moins 32 caractères aléatoires.
# L'API refuse de démarrer s'il est absent, trop court ou égal à une valeur connue.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<générer-un-secret-aléatoire-de-48-octets>"
# Durée de validité des jetons (ex. 12h, 7d).
JWT_EXPIRES_IN="12h"

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
CORS_ORIGINS="http://localhost:3012"

# Optionnel : derrière un reverse proxy, nombre de proxys de confiance (ex. 1) pour
# que la limitation de débit voie l'IP réelle du client.
# TRUST_PROXY=1
