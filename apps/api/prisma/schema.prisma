// Schéma Prisma — Syndic Alpha
// Périmètre actuel : SOCLE + module PATRIMOINE uniquement.
// Les autres modules (propriété, tantièmes, appels de fonds…) seront ajoutés
// un par un. Conception d'ensemble : ../../../docs/data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// SOCLE — multi-tenant, utilisateurs, audit
// =====================================================================

model Syndic {
  id        String   @id @default(uuid())
  nom       String
  pays      String // code ISO, pilote les règles juridiques paramétrables
  devise    String   @default("XOF")
  createdAt DateTime @default(now())

  users        User[]
  coproprietes Copropriete[]
  personnes    Personne[]
}

model User {
  id          String   @id @default(uuid())
  syndicId    String
  email       String   @unique
  motDePasse  String // hash bcrypt
  nom         String
  adminSyndic Boolean  @default(false) // accès à toutes les copros du syndic
  actif       Boolean  @default(true)
  mfaActive   Boolean  @default(false)
  createdAt   DateTime @default(now())

  syndic Syndic                @relation(fields: [syndicId], references: [id])
  roles  UserCoproprieteRole[]

  @@index([syndicId])
}

enum RoleType {
  ADMIN_SYNDIC
  GESTIONNAIRE
  COMPTABLE
  CAISSIER
}

// RBAC : un utilisateur a un rôle DIFFÉRENT par copropriété (règle 23.3)
model UserCoproprieteRole {
  id            String   @id @default(uuid())
  userId        String
  coproprieteId String
  role          RoleType

  user        User        @relation(fields: [userId], references: [id])
  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])

  @@unique([userId, coproprieteId, role])
}

// Journal d'audit append-only (aucun UPDATE/DELETE autorisé côté applicatif)
model AuditLog {
  id            String   @id @default(uuid())
  syndicId      String
  coproprieteId String?
  userId        String?
  entite        String // ex. "Copropriete"
  entiteId      String
  action        String // CREATE | UPDATE | VALIDATE | CANCEL ...
  avant         Json?
  apres         Json?
  horodatage    DateTime @default(now())

  @@index([entite, entiteId])
  @@index([coproprieteId])
}

// =====================================================================
// PATRIMOINE — copropriété → bâtiment → niveau → lot
// =====================================================================

enum CoproprieteStatut {
  EN_CREATION
  ACTIVE
  INACTIVE
  CLOTUREE
}

// Règle 1.7 : bâtiments résidentiels, commerciaux ou mixtes.
enum CoproprieteType {
  RESIDENTIEL
  COMMERCIAL
  MIXTE
}

// Règle 1.18 : syndic professionnel ou bénévole.
enum NatureSyndic {
  PROFESSIONNEL
  BENEVOLE
}

// Mode de génération / répartition des appels de fonds (extensions analyse :
// tantièmes, clés de répartition, montant fixe, ou mixte). Paramétrable par copropriété.
enum ModeRepartition {
  TANTIEMES
  CLES_REPARTITION
  MONTANT_FIXE
  MIXTE
}

model Copropriete {
  id                   String            @id @default(uuid())
  syndicId             String
  nom                  String
  reference            String? // code / identifiant interne
  type                 CoproprieteType   @default(RESIDENTIEL) // règle 1.7
  pays                 String // code ISO — pilote les règles juridiques de CETTE copropriété
  adresse              String?
  ensembleImmobilier   String? // rattachement résidence / ensemble (règle 1.16)
  devise               String            @default("XOF") // règle 1.13
  natureSyndic         NatureSyndic      @default(PROFESSIONNEL) // règle 1.18
  modeRepartition      ModeRepartition   @default(TANTIEMES) // mode de génération des appels
  description          String?
  statut               CoproprieteStatut @default(EN_CREATION) // règle 1.15
  dateCreation         DateTime          @default(now()) // règle 1.14
  dateMiseExploitation DateTime? // règle 1.14

  syndic          Syndic                @relation(fields: [syndicId], references: [id])
  batiments       Batiment[]
  lots            Lot[]
  roles           UserCoproprieteRole[]
  cles            CleRepartition[]
  appels          AppelDeFonds[]
  paiements       Paiement[]
  exercices       Exercice[]
  budgets         Budget[]
  partiesCommunes PartieCommune[]
  equipements     Equipement[]
  acces           Acces[]
  reglements      ReglementVersion[]
  documents       Document[]

  @@index([syndicId])
}

model Batiment {
  id            String @id @default(uuid())
  coproprieteId String
  nom           String // ex. "Bâtiment A", "Bloc 1"

  copropriete     Copropriete     @relation(fields: [coproprieteId], references: [id])
  niveaux         Niveau[]
  lots            Lot[]
  partiesCommunes PartieCommune[]
  equipements     Equipement[]
  acces           Acces[]

  @@index([coproprieteId])
}

model Niveau {
  id         String @id @default(uuid())
  batimentId String
  nom        String // ex. "RDC", "1er étage"
  ordre      Int    @default(0)

  batiment Batiment @relation(fields: [batimentId], references: [id])
  lots     Lot[]

  @@index([batimentId])
}

enum LotType {
  APPARTEMENT
  PARKING
  CAVE
  MAGASIN
  BUREAU
  ENTREPOT
  AUTRE
}

enum LotStatut {
  OCCUPE_PROPRIETAIRE
  LOUE
  VACANT
  EN_TRAVAUX
  INDISPONIBLE
  VENDU
  FUSIONNE // lot absorbé par une fusion (terminal, conservé pour l'historique)
  SUBDIVISE // lot éclaté par une subdivision (terminal, conservé pour l'historique)
}

model Lot {
  id             String    @id @default(uuid())
  coproprieteId  String
  batimentId     String?
  niveauId       String?
  lotPrincipalId String? // si ce lot est une annexe d'un lot principal (règle 2.11)
  origineLotId   String? // lot dont celui-ci est issu (subdivision/fusion, règles 2.13-14)
  reference      String // identifiant unique DANS la copropriété (ex. "A101")
  type           LotType
  designation    String?
  superficie     Decimal?  @db.Decimal(10, 2) // m² (surface, PAS de l'argent)
  statut         LotStatut @default(VACANT)

  copropriete  Copropriete          @relation(fields: [coproprieteId], references: [id])
  batiment     Batiment?            @relation(fields: [batimentId], references: [id])
  niveau       Niveau?              @relation(fields: [niveauId], references: [id])
  lotPrincipal Lot?                 @relation("Annexes", fields: [lotPrincipalId], references: [id])
  annexes      Lot[]                @relation("Annexes")
  origineLot   Lot?                 @relation("Lignee", fields: [origineLotId], references: [id])
  lotsDerivies Lot[]                @relation("Lignee")
  detentions   DetentionPropriete[]
  tantiemes    Tantieme[]
  lignesAppel  LigneAppelDeFonds[]

  @@unique([coproprieteId, reference])
  @@index([coproprieteId])
}

// =====================================================================
// MODULE 02 — PERSONNES (copropriétaires) & PROPRIÉTÉ (M:N)
// =====================================================================

enum PersonneType {
  PHYSIQUE
  MORALE
}

// Statut d'un copropriétaire (règles 3.11, 3.21, 3.22). Un statut non ACTIF ne
// supprime jamais ses droits de propriété ni son historique.
enum PersonneStatut {
  ACTIF
  SUSPENDU // accès applicatifs suspendus (3.21)
  DECEDE // décédé, lots conservés (3.22)
  SUCCESSION // succession non liquidée (3.11)
}

// Mode de réception des notifications (règle 3.19).
enum ModeNotification {
  EMAIL
  SMS
  COURRIER
  AUCUN
}

// Nature d'une représentation (règles 3.5, 3.6, 3.12).
enum NatureRepresentation {
  MANDATAIRE
  TUTEUR
  REPRESENTANT_LEGAL
}

// Une personne vit au niveau du SYNDIC : elle peut posséder des lots
// dans plusieurs copropriétés du même syndic (règle 3.15).
model Personne {
  id                   String                @id @default(uuid())
  syndicId             String
  type                 PersonneType
  nom                  String // nom de famille ou raison sociale
  prenom               String? // personnes physiques
  actif                Boolean               @default(true)
  statut               PersonneStatut        @default(ACTIF)
  modeNotification     ModeNotification      @default(EMAIL)
  representantId       String? // mandataire / tuteur / représentant légal (3.5-3.6)
  natureRepresentation NatureRepresentation?
  createdAt            DateTime              @default(now())

  syndic      Syndic               @relation(fields: [syndicId], references: [id])
  contacts    Contact[]
  detentions  DetentionPropriete[]
  lignesDues  LigneAppelDeFonds[]  @relation("Redevable")
  paiements   Paiement[]           @relation("Payeur")
  representant Personne?           @relation("Representation", fields: [representantId], references: [id])
  represente  Personne[]           @relation("Representation")

  @@index([syndicId])
}

enum ContactType {
  EMAIL
  TELEPHONE
  ADRESSE_POSTALE
}

// Coordonnées multiples et typées (règles 3.16 à 3.18).
model Contact {
  id         String      @id @default(uuid())
  personneId String
  type       ContactType
  valeur     String // l'email, le numéro, l'adresse
  libelle    String? // ex. "facturation", "perso"
  principal  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  personne Personne @relation(fields: [personneId], references: [id])

  @@index([personneId])
}

enum NatureDroit {
  PLEINE_PROPRIETE
  USUFRUIT
  NUE_PROPRIETE
  INDIVISION
}

// ⚠️ LE CŒUR : relation plusieurs-à-plusieurs Personne ↔ Lot.
// JAMAIS de lien direct 1:1. Sert aussi d'HISTORIQUE des mutations.
// Quote-part exacte en numérateur/dénominateur (jamais de décimal).
model DetentionPropriete {
  id           String      @id @default(uuid())
  lotId        String
  personneId   String
  quotePartNum Int // numérateur (ex. 1)
  quotePartDen Int // dénominateur (ex. 3) → quote-part = num/den
  natureDroit  NatureDroit @default(PLEINE_PROPRIETE)
  dateDebut    DateTime
  dateFin      DateTime? // null = détention en cours

  lot      Lot      @relation(fields: [lotId], references: [id])
  personne Personne @relation(fields: [personneId], references: [id])

  @@index([lotId, dateDebut])
  @@index([personneId])
}

// =====================================================================
// MODULE 03 — CLÉS DE RÉPARTITION & TANTIÈMES (versionnés par période)
// =====================================================================

model CleRepartition {
  id            String  @id @default(uuid())
  coproprieteId String
  nom           String // ex. "Charges générales", "Ascenseur A"
  description   String?

  copropriete  Copropriete             @relation(fields: [coproprieteId], references: [id])
  versions     CleRepartitionVersion[]
  postesBudget PosteBudget[]

  @@index([coproprieteId])
}

// Une clé est VERSIONNÉE : chaque version vaut à partir d'une date d'effet.
// Un calcul utilise la version applicable à la période (règle 5.15).
model CleRepartitionVersion {
  id             String    @id @default(uuid())
  cleId          String
  dateEffet      DateTime
  dateFin        DateTime? // null = version courante
  totalTantiemes Int // somme figée des tantièmes de cette version

  cle       CleRepartition @relation(fields: [cleId], references: [id])
  tantiemes Tantieme[]
  postes    PosteAppel[]

  @@index([cleId, dateEffet])
}

// =====================================================================
// MODULE — EXERCICES (domaine 25) & BUDGETS PRÉVISIONNELS (domaine 8)
// =====================================================================

enum ExerciceStatut {
  OUVERT
  EN_CLOTURE
  CLOTURE
}

model Exercice {
  id            String         @id @default(uuid())
  coproprieteId String
  libelle       String // ex. "Exercice 2026"
  dateDebut     DateTime
  dateFin       DateTime
  statut        ExerciceStatut @default(OUVERT)
  createdAt     DateTime       @default(now())

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])
  budgets     Budget[]

  @@index([coproprieteId])
}

enum BudgetStatut {
  BROUILLON
  SOUMIS
  APPROUVE
  REJETE
}

model Budget {
  id              String       @id @default(uuid())
  coproprieteId   String
  exerciceId      String
  libelle         String?
  version         Int          @default(1)
  statut          BudgetStatut @default(BROUILLON)
  dateApprobation DateTime?
  createdAt       DateTime     @default(now())

  copropriete Copropriete   @relation(fields: [coproprieteId], references: [id])
  exercice    Exercice      @relation(fields: [exerciceId], references: [id])
  postes      PosteBudget[]

  @@index([coproprieteId])
  @@index([exerciceId])
}

// Nature d'une dépense prévue (règles 8.9 / 8.10).
enum NaturePoste {
  RECURRENTE
  EXCEPTIONNELLE
}

model PosteBudget {
  id           String      @id @default(uuid())
  budgetId     String
  libelle      String // ex. "Gardiennage"
  categorie    String? // catégorie comptable (règle 8.7)
  cleId        String? // clé de répartition associée (règle 8.8)
  nature       NaturePoste @default(RECURRENTE)
  montantPrevu BigInt // entier, unité de la devise

  budget Budget          @relation(fields: [budgetId], references: [id])
  cle    CleRepartition? @relation(fields: [cleId], references: [id])

  @@index([budgetId])
}

model Tantieme {
  id        String @id @default(uuid())
  versionId String
  lotId     String
  valeur    Int // tantièmes du lot dans cette version de la clé

  version CleRepartitionVersion @relation(fields: [versionId], references: [id])
  lot     Lot                   @relation(fields: [lotId], references: [id])

  @@unique([versionId, lotId])
}

// =====================================================================
// MODULE 04 — APPELS DE FONDS (génération + calcul par lot et redevable)
// =====================================================================

enum AppelType {
  ORDINAIRE
  EXCEPTIONNEL
}

enum AppelStatut {
  BROUILLON
  VALIDE
  ANNULE
}

model AppelDeFonds {
  id            String      @id @default(uuid())
  coproprieteId String
  numero        String // unique dans la copropriété (ex. AF-2026-0001)
  type          AppelType   @default(ORDINAIRE)
  motif         String
  dateEmission  DateTime    @default(now())
  dateEcheance  DateTime
  statut        AppelStatut @default(BROUILLON)

  copropriete Copropriete         @relation(fields: [coproprieteId], references: [id])
  postes      PosteAppel[]
  lignes      LigneAppelDeFonds[]

  @@unique([coproprieteId, numero])
  @@index([coproprieteId])
}

// Un poste = une clé (version) + un montant à répartir sur son périmètre.
model PosteAppel {
  id               String @id @default(uuid())
  appelId          String
  cleVersionId     String
  libelle          String
  montantARepartir BigInt // entier, unité de la devise

  appel      AppelDeFonds          @relation(fields: [appelId], references: [id])
  cleVersion CleRepartitionVersion @relation(fields: [cleVersionId], references: [id])
  lignes     LigneAppelDeFonds[]
}

// Une ligne = la part d'un redevable pour un lot et un poste.
// FIGE les tantièmes utilisés (traçabilité). Montant entier.
model LigneAppelDeFonds {
  id               String @id @default(uuid())
  appelId          String
  posteId          String
  lotId            String
  redevableId      String // redevable à la date d'exigibilité (usufruitier si usufruit)
  tantiemeSnapshot Int // tantièmes du lot figés au calcul
  totalSnapshot    Int // total figé au calcul
  montant          BigInt // entier, unité de la devise

  appel        AppelDeFonds          @relation(fields: [appelId], references: [id])
  poste        PosteAppel            @relation(fields: [posteId], references: [id])
  lot          Lot                   @relation(fields: [lotId], references: [id])
  redevable    Personne              @relation("Redevable", fields: [redevableId], references: [id])
  affectations AffectationPaiement[]

  @@index([appelId])
  @@index([redevableId])
}

// =====================================================================
// MODULE 05 — ENCAISSEMENTS & PAIEMENTS (paiement ≠ affectation)
// =====================================================================

enum MoyenPaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  MOBILE_MONEY
  PRELEVEMENT
  EN_LIGNE
}

enum PaiementStatut {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
}

// Un paiement REÇU. Distinct de son affectation aux dettes (règle fondamentale).
model Paiement {
  id                String         @id @default(uuid())
  coproprieteId     String
  payeurId          String // peut être un tiers payant pour un copropriétaire
  dateOperation     DateTime
  montant           BigInt // entier, unité de la devise
  moyen             MoyenPaiement
  referenceBancaire String?
  statut            PaiementStatut @default(VALIDE)
  idempotencyKey    String?        @unique // anti double-comptage Mobile Money
  createdAt         DateTime       @default(now())

  copropriete  Copropriete           @relation(fields: [coproprieteId], references: [id])
  payeur       Personne              @relation("Payeur", fields: [payeurId], references: [id])
  affectations AffectationPaiement[]

  @@index([coproprieteId])
}

// L'AFFECTATION : impute une partie d'un paiement à une ligne due. Opération séparée.
model AffectationPaiement {
  id             String   @id @default(uuid())
  paiementId     String
  ligneAppelId   String
  montantAffecte BigInt // entier
  createdAt      DateTime @default(now())

  paiement   Paiement          @relation(fields: [paiementId], references: [id])
  ligneAppel LigneAppelDeFonds @relation(fields: [ligneAppelId], references: [id])

  @@index([paiementId])
  @@index([ligneAppelId])
}

// =====================================================================
// MODULE 06 — IMPAYÉS & RECOUVREMENT
// Le solde d'une ligne se calcule (montant − Σ affectations) : pas de table
// "dette". On historise seulement les RELANCES du recouvrement.
// =====================================================================

enum CanalRelance {
  EMAIL
  SMS
  COURRIER
}

model Relance {
  id             String       @id @default(uuid())
  coproprieteId  String
  personneId     String
  niveau         Int          @default(1) // 1 = 1re relance, 2 = mise en demeure, ...
  canal          CanalRelance
  montantReclame BigInt // solde impayé figé au moment de la relance
  commentaire    String?
  dateEnvoi      DateTime     @default(now())

  @@index([coproprieteId, personneId])
}

// =====================================================================
// MODULE — PATRIMOINE TECHNIQUE : PARTIES COMMUNES (domaine 1.8) &
// ÉQUIPEMENTS (domaine 7). Inventaire technique de la copropriété.
// =====================================================================

enum PartieCommuneType {
  GENERALE // commune à toute la copropriété (règle 1.8)
  SPECIALE // commune à certains bâtiments / lots seulement
}

model PartieCommune {
  id            String            @id @default(uuid())
  coproprieteId String
  batimentId    String? // rattachement optionnel à un bâtiment (partie spéciale)
  nom           String // ex. "Hall", "Toiture", "Cour", "Local vélos"
  type          PartieCommuneType @default(GENERALE)
  description   String?
  createdAt     DateTime          @default(now())

  copropriete Copropriete  @relation(fields: [coproprieteId], references: [id])
  batiment    Batiment?    @relation(fields: [batimentId], references: [id])
  equipements Equipement[]

  @@index([coproprieteId])
}

// Catégories d'équipements (exemples de l'analyse, domaine 7).
enum EquipementCategorie {
  ASCENSEUR
  GROUPE_ELECTROGENE
  POMPE
  SURPRESSEUR
  RESERVOIR_EAU
  PORTAIL
  CAMERA
  SYSTEME_INCENDIE
  PISCINE
  CLIMATISATION
  INSTALLATION_ELECTRIQUE
  ECLAIRAGE
  CONTROLE_ACCES
  AUTRE
}

// Cycle de vie d'un équipement (règles 7.13 → 7.17).
enum EquipementEtat {
  EN_SERVICE
  EN_PANNE
  EN_MAINTENANCE
  HORS_SERVICE
  REMPLACE
}

model Equipement {
  id               String              @id @default(uuid())
  coproprieteId    String
  batimentId       String? // affecté à un bâtiment (règle 7.3)
  partieCommuneId  String? // situé dans une partie commune (règle 7.4)
  nom              String // ex. "Ascenseur A"
  categorie        EquipementCategorie // règle 7.5
  reference        String // règle 7.6
  numeroSerie      String? // règle 7.7
  dateInstallation DateTime? // règle 7.8
  garantieFin      DateTime? // fin de garantie (règle 7.9)
  fournisseur      String? // texte libre tant que le module Prestataires n'existe pas (règle 7.10)
  etat             EquipementEtat      @default(EN_SERVICE)
  notes            String?
  createdAt        DateTime            @default(now())

  copropriete   Copropriete    @relation(fields: [coproprieteId], references: [id])
  batiment      Batiment?      @relation(fields: [batimentId], references: [id])
  partieCommune PartieCommune? @relation(fields: [partieCommuneId], references: [id])

  @@unique([coproprieteId, reference])
  @@index([coproprieteId])
  @@index([batimentId])
}

// =====================================================================
// MODULE — ACCÈS (domaine 1.9) & RÈGLEMENT DE COPROPRIÉTÉ (domaines 1.10-11)
// =====================================================================

enum AccesType {
  PIETON
  VEHICULE
  PARKING
  LIVRAISON
  SECOURS
  AUTRE
}

model Acces {
  id            String    @id @default(uuid())
  coproprieteId String
  batimentId    String? // accès rattaché à un bâtiment précis (optionnel)
  nom           String // ex. "Entrée principale", "Portail parking"
  type          AccesType @default(PIETON)
  description   String?
  createdAt     DateTime  @default(now())

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])
  batiment    Batiment?   @relation(fields: [batimentId], references: [id])

  @@index([coproprieteId])
}

// Une copropriété possède UN règlement, conservé en VERSIONS successives
// (règles 1.10-1.11). Une seule version « courante » (en vigueur) à la fois.
model ReglementVersion {
  id            String   @id @default(uuid())
  coproprieteId String
  version       Int      @default(1)
  dateAdoption  DateTime? // date d'adoption / entrée en vigueur
  reference     String? // référence du document (ex. acte notarié)
  description   String?
  documentId    String? // document (PDF) téléversé — remplace l'ancien lien URL
  courant       Boolean  @default(true) // version en vigueur
  createdAt     DateTime @default(now())

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])
  document    Document?   @relation(fields: [documentId], references: [id])

  @@index([coproprieteId])
}

// Fichier téléversé (PDF, image…). Stockage local pour le MVP ; la clé
// `cheminStockage` pointera vers S3/MinIO quand le stockage objet sera branché.
model Document {
  id             String   @id @default(uuid())
  syndicId       String
  coproprieteId  String?
  nomOriginal    String // nom affiché (tel que téléversé)
  cheminStockage String // nom de fichier interne (uuid.ext)
  mimeType       String
  taille         Int // octets
  createdAt      DateTime @default(now())

  copropriete Copropriete?       @relation(fields: [coproprieteId], references: [id])
  reglements  ReglementVersion[]

  @@index([coproprieteId])
}
